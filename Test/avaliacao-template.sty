\newcommand{\ModoQuestoes}{%
  \avaliacao@modoquestoestrue
  \avaliacao@modofolhafalse
  \avaliacao@modogabaritofalse
}
\newcommand{\ModoFolhaRespostas}{%
  \avaliacao@modoquestoesfalse
  \avaliacao@modofolhatrue
  \avaliacao@modogabaritofalse
}
\newcommand{\ModoGabarito}{%
  \avaliacao@modoquestoesfalse
  \avaliacao@modofolhafalse
  \avaliacao@modogabaritotrue
}
\ModoQuestoes

\newcommand{\avaliacao@resetresposta}{%
  \gdef\avaliacao@tipo{}%
  \gdef\avaliacao@linhas{6}%
  \gdef\avaliacao@alturadiagrama{5cm}%
  \gdef\avaliacao@alturacaixa{5cm}%
  \gdef\avaliacao@alturalinha{0.30cm}%
  \gdef\avaliacao@texto{}%
  \gdef\avaliacao@respostafechada{}%
  \gdef\avaliacao@numopcoes{0}%
}
\avaliacao@resetresposta

\newcommand{\avaliacao@cabecalho}{%
  \small\textbf{\NomeAvaliacao{} -- \CodigoDisciplina{} -- \NomeDisciplina{}}%
}

\newcommand{\avaliacao@totalpaginas}{%
  \ifavaliacao@modofolha
    \pageref{UltimaPaginaFolhaRespostas}%
  \else
    \ifavaliacao@modogabarito
      \pageref{LastPage}%
    \else
      \pageref{UltimaPaginaCadernoQuestoes}%
    \fi
  \fi
}

\newcommand{\avaliacao@marcarpaginaimediata}[1]{%
  \begingroup
  \ifdim\pagetotal=0pt
    \ifnum\value{page}>1
      \edef\avaliacao@paginaatual{\number\numexpr\value{page}-1\relax}%
    \else
      \edef\avaliacao@paginaatual{\thepage}%
    \fi
  \else
    \edef\avaliacao@paginaatual{\thepage}%
  \fi
  \immediate\write\@auxout{%
    \string\newlabel{#1}{{}{\avaliacao@paginaatual}}%
  }%
  \endgroup
}

\newcommand{\MarcarUltimaPaginaFolhaRespostas}{%
  \avaliacao@marcarpaginaimediata{UltimaPaginaFolhaRespostas}%
}

\fancypagestyle{cadernoQuestoes}{%
  \fancyhf{}%
  \fancyhead[C]{\avaliacao@cabecalho\\[-0.25em]\rule{\textwidth}{0.4pt}}%
  \fancyfoot[C]{\rule{\textwidth}{0.4pt}\\[-0.15em]\small\thepage/\avaliacao@totalpaginas}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

\newcommand{\CapaCadernoQuestoes}{%
  \thispagestyle{empty}%
  \begin{center}
    \IfFileExists{\LogoInstituicao}{%
      \includegraphics[height=2.1cm,keepaspectratio]{\LogoInstituicao}%
    }{%
      \fbox{\parbox[c][1.8cm][c]{8cm}{\centering Logo da instituicao}}%
    }\\[0.8cm]
    {\Large\bfseries \NomeAvaliacao}\\[0.2cm]
    {\normalsize\bfseries \PontuacaoAvaliacao}
  \end{center}

  \begin{tabularx}{\textwidth}{@{}>{\bfseries}p{4.0cm}Y@{}}
    Código: & \CodigoDisciplina \\
    Disciplina: & \NomeDisciplina \\
    Data: & \DataAvaliacao \\
    Professor(a): & \ProfessorAvaliacao \\
  \end{tabularx}

  \section*{Orientações}
  \OrientacoesProva
  \clearpage
}

\newcommand{\IdentificacaoFolhaRespostas}{%
  \section*{Folha de Respostas}
  \begin{tabularx}{\textwidth}{@{}>{\bfseries}p{4.7cm}Y@{}}
    Avaliação: & \NomeAvaliacao{} -- \PontuacaoAvaliacao \\
    Disciplina: & \CodigoDisciplina{} -- \NomeDisciplina \\
    Data: & \DataAvaliacao \\
    Nome do(a) aluno(a): & \linhaCompleta \\
    Nota da correção: & \campo{4cm} \\
  \end{tabularx}
  \par\medskip
}

\newcommand{\TituloGabarito}{%
  \begin{center}
    {\Large\bfseries Gabarito}\\[0.15cm]
    {\normalsize \NomeAvaliacao{} -- \CodigoDisciplina{} -- \NomeDisciplina}\\
    {\normalsize \PontuacaoAvaliacao{} \quad Data: \DataAvaliacao}
  \end{center}
  \par\medskip
}

\newenvironment{questao}[1][]{%
  \refstepcounter{questao}%
  \avaliacao@resetresposta
  \ifavaliacao@modoquestoes
    \par\Needspace{5\baselineskip}%
    \noindent\textbf{Questão \thequestao}%
    \if\relax\detokenize{#1}\relax\else\hfill\textbf{#1}\fi%
    \par\nobreak\smallskip
  \else
    \begingroup
    \let\figure\center
    \let\endfigure\endcenter
    \let\table\center
    \let\endtable\endcenter
    \setbox\avaliacaoCaixaDescarte=\vbox\bgroup
    \hsize=\textwidth
    \linewidth=\textwidth
    \parindent=0pt
  \fi
}{%
  \ifavaliacao@modoquestoes
    \par
  \else
    \par\egroup
    \endgroup
    \ifavaliacao@modofolha
      \avaliacao@imprimirfolha
    \fi
    \ifavaliacao@modogabarito
      \avaliacao@imprimirgabarito
    \fi
  \fi
}

\newenvironment{alternativas}{%
  \global\def\avaliacao@tipo{alternativas}%
  \global\def\avaliacao@numopcoes{0}%
  \setcounter{avaliacaoAlternativa}{0}%
  \begin{enumerate}[label=\alph*)]
  \let\avaliacao@itemoriginal\item
  \def\item{\@ifnextchar[{\avaliacao@itemalternativa}{\avaliacao@itemalternativa[]}}%
}{%
  \end{enumerate}
}

\newcommand{\avaliacao@guardarrespostaalternativa}{%
  \ifcase\c@avaliacaoAlternativa
  \or\gdef\avaliacao@respostafechada{a}%
  \or\gdef\avaliacao@respostafechada{b}%
  \or\gdef\avaliacao@respostafechada{c}%
  \or\gdef\avaliacao@respostafechada{d}%
  \or\gdef\avaliacao@respostafechada{e}%
  \or\gdef\avaliacao@respostafechada{f}%
  \or\gdef\avaliacao@respostafechada{g}%
  \or\gdef\avaliacao@respostafechada{h}%
  \else\xdef\avaliacao@respostafechada{\number\c@avaliacaoAlternativa}%
  \fi
}

\def\avaliacao@itemalternativa[#1]{%
  \avaliacao@itemoriginal
  \stepcounter{avaliacaoAlternativa}%
  \xdef\avaliacao@numopcoes{\number\c@avaliacaoAlternativa}%
  \ifstrequal{#1}{correta}{%
    \avaliacao@guardarrespostaalternativa
  }{}%
}

\newcommand{\resposta}[2][6]{%
  \global\def\avaliacao@tipo{aberta}%
  \global\def\avaliacao@linhas{#1}%
  \global\def\avaliacao@alturalinha{0.30cm}%
  \gdef\avaliacao@texto{#2}%
}
\let\respostaAberta\resposta

\newcommand{\respostaLinhas}[3][6]{%
  \global\def\avaliacao@tipo{aberta}%
  \global\def\avaliacao@linhas{#1}%
  \global\def\avaliacao@alturalinha{#2}%
  \gdef\avaliacao@texto{#3}%
}
\let\respostaAlturaLinhas\respostaLinhas

\newcommand{\respostaDiagrama}[3][5cm]{%
  \global\def\avaliacao@tipo{diagrama}%
  \global\def\avaliacao@alturadiagrama{#1}%
  \global\def\avaliacao@linhas{#2}%
  \global\def\avaliacao@alturalinha{0.30cm}%
  \gdef\avaliacao@texto{#3}%
}

\newcommand{\respostaCaixa}[2][5cm]{%
  \global\def\avaliacao@tipo{caixa}%
  \global\def\avaliacao@alturacaixa{#1}%
  \gdef\avaliacao@texto{#2}%
}

\newcommand{\respostaFechada}[2][alternativas]{%
  \global\def\avaliacao@tipo{#1}%
  \xdef\avaliacao@respostafechada{#2}%
  \ifstrequal{#1}{certoerrado}{\global\def\avaliacao@numopcoes{2}}{}%
}

\newcommand{\opcoesCertoErrado}{%
  \global\def\avaliacao@tipo{certoerrado}%
  \global\def\avaliacao@numopcoes{2}%
  \ifavaliacao@modoquestoes
    \begin{enumerate}[label=\alph*)]
      \item Certo
      \item Errado
    \end{enumerate}
  \fi
}

\newcommand{\respostaCertoErrado}[1]{%
  \global\def\avaliacao@tipo{certoerrado}%
  \global\def\avaliacao@numopcoes{2}%
  \xdef\avaliacao@respostafechada{#1}%
}

\newcommand{\avaliacao@titulocaixaresposta}{%
  \ifavaliacao@continuacaoresposta
    \edef\avaliacao@tituloquestaoatual{Questão \thequestao{} (continuação)}%
  \else
    \edef\avaliacao@tituloquestaoatual{Questão \thequestao}%
  \fi
}

\newcommand{\avaliacao@atualizarespacodisponivel}{%
  \par
  \ifdim\pagegoal=\maxdimen
    \avaliacaoEspacoDisponivel=\textheight
  \else
    \avaliacaoEspacoDisponivel=\dimexpr\pagegoal-\pagetotal\relax
  \fi
  \advance\avaliacaoEspacoDisponivel by -2pt
  \ifdim\avaliacaoEspacoDisponivel<0pt
    \avaliacaoEspacoDisponivel=0pt
  \fi
}

\newcommand{\avaliacao@montarcaixaresposta}[1]{%
  \begingroup
  \setlength{\fboxsep}{0.2cm}%
  \setlength{\fboxrule}{0.4pt}%
  \fbox{%
    \vbox{%
      \hsize=\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax
      \linewidth=\hsize
      \parindent=0pt
      \parskip=0pt
      \ifavaliacao@omitirtituloresposta
      \else
        \textbf{\avaliacao@tituloquestaoatual}\par
        \vskip0.55em
      \fi
      #1%
    }%
  }%
  \endgroup
}

\newcommand{\avaliacao@medircaixacomconteudo}[1]{%
  \avaliacao@titulocaixaresposta
  \setbox\avaliacaoCaixaMedida=\hbox{\avaliacao@montarcaixaresposta{#1}}%
  \avaliacaoAlturaCaixaMedida=\dimexpr\ht\avaliacaoCaixaMedida+\dp\avaliacaoCaixaMedida\relax
}

\newcommand{\avaliacao@imprimircaixamedida}{%
  \noindent\copy\avaliacaoCaixaMedida\par\medskip
  \avaliacao@respostainiciadatrue
}

\newcommand{\avaliacao@espacovazioresposta}[1]{%
  \vbox to #1{\vfil}%
}

\newcommand{\avaliacao@linhanumerada}{%
  \hbox to \hsize{%
    \smash{\scriptsize\color{IFDark!60}\number\avaliacaoNumeroLinhaAtual}%
    \hskip0.2cm%
    \leaders\hrule height 0.35pt\hfill
  }%
}

\newcommand{\avaliacao@desenharlinhas}[2]{%
  \avaliacaoContadorLinhas=0
  \avaliacaoNumeroLinhaAtual=\avaliacaoNumeroLinhaInicio
  \loop\ifnum\avaliacaoContadorLinhas<#1
    \ifnum\avaliacaoContadorLinhas=0
      \vskip0.78cm
    \else
      \vskip#2\relax
    \fi
    \avaliacao@linhanumerada
    \advance\avaliacaoContadorLinhas by 1
    \advance\avaliacaoNumeroLinhaAtual by 1
  \repeat
}

\newcommand{\avaliacao@medircaixaespaco}[1]{%
  \avaliacao@medircaixacomconteudo{\avaliacao@espacovazioresposta{#1}}%
}

\newcommand{\avaliacao@medircaixalinhas}[2]{%
  \avaliacao@medircaixacomconteudo{\avaliacao@desenharlinhas{#1}{#2}}%
}

\newcommand{\avaliacao@medircaixadiagramacompleta}[2]{%
  \avaliacao@medircaixacomconteudo{%
    \avaliacao@espacovazioresposta{#1}%
    \vskip0.25cm
    \hrule height 0.35pt width \hsize
    \avaliacao@desenharlinhas{#2}{\avaliacao@alturalinha}%
  }%
}

\newcommand{\avaliacao@ajustaralturaespaco}{%
  \avaliacao@medircaixaespaco{\avaliacaoAlturaChunk}%
  \ifdim\avaliacaoAlturaCaixaMedida>\avaliacaoEspacoDisponivel
    \avaliacaoExcessoCaixa=\dimexpr\avaliacaoAlturaCaixaMedida-\avaliacaoEspacoDisponivel+2pt\relax
    \advance\avaliacaoAlturaChunk by -\avaliacaoExcessoCaixa
    \ifdim\avaliacaoAlturaChunk<0pt
      \avaliacaoAlturaChunk=0pt
    \fi
    \avaliacao@medircaixaespaco{\avaliacaoAlturaChunk}%
  \fi
}

\newcommand{\avaliacao@imprimirespacomultipagina}[1]{%
  \avaliacaoAlturaMinimaChunk=0.8cm
  \avaliacaoAlturaRestante=#1\relax
  \avaliacao@imprimirespacorestante
}

\newcommand{\avaliacao@imprimirespacorestante}{%
  \ifdim\avaliacaoAlturaRestante>0pt
    \avaliacao@atualizarespacodisponivel
    \avaliacaoAlturaChunk=\avaliacaoAlturaRestante
    \avaliacao@ajustaralturaespaco
    \ifdim\avaliacaoAlturaRestante>\avaliacaoAlturaMinimaChunk
      \ifdim\avaliacaoAlturaChunk<\avaliacaoAlturaMinimaChunk
        \clearpage
        \ifavaliacao@respostainiciada
          \avaliacao@continuacaorespostatrue
        \fi
        \avaliacao@atualizarespacodisponivel
        \avaliacaoAlturaChunk=\avaliacaoAlturaRestante
        \avaliacao@ajustaralturaespaco
      \fi
    \fi
    \ifdim\avaliacaoAlturaChunk<1pt
      \clearpage
      \ifavaliacao@respostainiciada
        \avaliacao@continuacaorespostatrue
      \fi
      \avaliacao@imprimirespacorestante
    \else
      \avaliacao@imprimircaixamedida
      \advance\avaliacaoAlturaRestante by -\avaliacaoAlturaChunk
      \ifdim\avaliacaoAlturaRestante>0pt
        \avaliacao@continuacaorespostatrue
        \clearpage
        \avaliacao@imprimirespacorestante
      \fi
    \fi
  \fi
}

\newcommand{\avaliacao@selecionarlinhasquecaibam}[2]{%
  \avaliacaoLinhasChunk=#1\relax
  \avaliacao@medircaixalinhas{\number\avaliacaoLinhasChunk}{#2}%
  \loop\ifdim\avaliacaoAlturaCaixaMedida>\avaliacaoEspacoDisponivel
    \advance\avaliacaoLinhasChunk by -1
    \ifnum\avaliacaoLinhasChunk<1
      \avaliacaoLinhasChunk=0
      \avaliacaoAlturaCaixaMedida=0pt
    \else
      \avaliacao@medircaixalinhas{\number\avaliacaoLinhasChunk}{#2}%
    \fi
  \repeat
}

\newcommand{\avaliacao@imprimirlinhasmultipagina}[2]{%
  \avaliacaoLinhasRestantes=#1\relax
  \avaliacaoNumeroLinhaInicio=1
  \avaliacao@imprimirlinhasrestantes{#2}%
}

\newcommand{\avaliacao@imprimirlinhasrestantes}[1]{%
  \ifnum\avaliacaoLinhasRestantes>0
    \avaliacao@atualizarespacodisponivel
    \avaliacao@selecionarlinhasquecaibam{\number\avaliacaoLinhasRestantes}{#1}%
    \ifnum\avaliacaoLinhasChunk<1
      \clearpage
      \avaliacao@omitirtitulorespostafalse
      \ifavaliacao@respostainiciada
        \avaliacao@continuacaorespostatrue
      \fi
      \avaliacao@atualizarespacodisponivel
      \avaliacao@selecionarlinhasquecaibam{\number\avaliacaoLinhasRestantes}{#1}%
      \ifnum\avaliacaoLinhasChunk<1
        \avaliacaoLinhasChunk=1
        \avaliacao@medircaixalinhas{1}{#1}%
      \fi
    \fi
    \avaliacao@imprimircaixamedida
    \avaliacao@omitirtitulorespostafalse
    \advance\avaliacaoNumeroLinhaInicio by \avaliacaoLinhasChunk
    \advance\avaliacaoLinhasRestantes by -\avaliacaoLinhasChunk
    \ifnum\avaliacaoLinhasRestantes>0
      \avaliacao@continuacaorespostatrue
      \clearpage
      \avaliacao@imprimirlinhasrestantes{#1}%
    \fi
  \fi
}

\newcommand{\avaliacao@caixaresposta}[2]{%
  \avaliacao@continuacaorespostafalse
  \avaliacao@respostainiciadafalse
  \avaliacao@omitirtitulorespostafalse
  \avaliacao@imprimirlinhasmultipagina{#1}{#2}%
}

\newcommand{\avaliacao@caixavaziaresposta}[1]{%
  \avaliacao@continuacaorespostafalse
  \avaliacao@respostainiciadafalse
  \avaliacao@omitirtitulorespostafalse
  \avaliacao@imprimirespacomultipagina{#1}%
}

\newcommand{\avaliacao@caixadiagramaresposta}[2]{%
  \avaliacao@continuacaorespostafalse
  \avaliacao@respostainiciadafalse
  \avaliacao@omitirtitulorespostafalse
  \avaliacaoNumeroLinhaInicio=1
  \avaliacao@atualizarespacodisponivel
  \avaliacao@medircaixadiagramacompleta{#1}{#2}%
  \ifdim\avaliacaoAlturaCaixaMedida<\avaliacaoEspacoDisponivel
    \avaliacao@imprimircaixamedida
  \else
    \avaliacao@imprimirespacomultipagina{#1}%
    \ifnum#2>0
      \ifavaliacao@respostainiciada
        \avaliacao@continuacaorespostatrue
        \avaliacao@omitirtitulorespostatrue
      \fi
      \avaliacao@imprimirlinhasmultipagina{#2}{\avaliacao@alturalinha}%
    \fi
  \fi
}

\newcommand{\avaliacao@opcoesalternativas}{%
  \setcounter{avaliacaoOpcao}{1}%
  \loop\ifnum\value{avaliacaoOpcao}<\numexpr\avaliacao@numopcoes+1\relax
    \fbox{\rule{0pt}{1.1em}\hspace{1.1em}}\hspace{0.25em}\alph{avaliacaoOpcao}\hspace{1.0em}%
    \stepcounter{avaliacaoOpcao}%
  \repeat
}

\newcommand{\avaliacao@imprimirfolha}{%
  \par
  \ifdefstring{\avaliacao@tipo}{alternativas}{%
    \Needspace{6\baselineskip}%
    \noindent\textbf{Questão \thequestao}\par\nopagebreak\smallskip
    \avaliacao@opcoesalternativas\par\medskip
  }{%
    \ifdefstring{\avaliacao@tipo}{certoerrado}{%
      \Needspace{6\baselineskip}%
      \noindent\textbf{Questão \thequestao}\par\nopagebreak\smallskip
      \fbox{\rule{0pt}{1.1em}\hspace{1.1em}}\hspace{0.25em}Certo\hspace{1.2em}%
      \fbox{\rule{0pt}{1.1em}\hspace{1.1em}}\hspace{0.25em}Errado\par\medskip
    }{%
      \ifdefstring{\avaliacao@tipo}{diagrama}{%
        \avaliacao@caixadiagramaresposta{\avaliacao@alturadiagrama}{\avaliacao@linhas}%
      }{%
        \ifdefstring{\avaliacao@tipo}{caixa}{%
          \avaliacao@caixavaziaresposta{\avaliacao@alturacaixa}%
        }{%
          \avaliacao@caixaresposta{\avaliacao@linhas}{\avaliacao@alturalinha}%
        }%
      }%
    }%
  }%
}

\newcommand{\avaliacao@imprimirgabarito}{%
  \ifdefempty{\avaliacao@texto}{%
    \ifdefempty{\avaliacao@respostafechada}{}{%
      \stepcounter{avaliacaoGabaritoItens}%
      \par\Needspace{3\baselineskip}%
      \noindent\textbf{Questão \thequestao.} \avaliacao@respostafechada\par
    }%
  }{%
